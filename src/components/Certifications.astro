---
import data from '../data/portfolio.json';
const { certifications } = data;
---

<section class="section !pb-0 md:!pb-10 relative overflow-hidden" id="certifications">
  <!-- Background Glow Effect -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none opacity-20 dark:opacity-10">
    <div class="absolute top-1/3 -right-20 w-80 h-80 bg-primary blur-[150px] rounded-full animate-pulse"></div>
    <div class="absolute bottom-1/3 -left-20 w-80 h-80 bg-secondary blur-[150px] rounded-full animate-pulse" style="animation-delay: 3s;"></div>
  </div>

  <div class="container relative z-10 pt-10">
    <div id="certifications-header" class="text-center mb-8">
      <h2 class="section-title mb-2 opacity-0 translate-y-4" data-i18n="certifications_title">Certificaciones y Logros</h2>
      <span class="section-subtitle opacity-0 translate-y-4" data-i18n="certifications_subtitle">Mis credenciales profesionales y académicas</span>
    </div>
    
    <!-- Swipe hint (Only visible on mobile) -->
    <div class="flex lg:hidden justify-end px-6 mb-4 opacity-70">
      <span class="text-xs font-semibold tracking-widest uppercase flex items-center gap-2 text-primary">
        Desliza para ver más
        <iconify-icon icon="line-md:arrow-right" class="text-lg animate-pulse"></iconify-icon>
      </span>
    </div>
  </div>

  <!-- Contenedor Pin -->
  <div id="cert-pin-container" class="relative w-full overflow-hidden">
    <!-- Pista Deslizable -->
    <div id="cert-track" class="flex gap-8 px-6 lg:px-[10vw] w-full lg:w-max overflow-x-auto lg:overflow-visible snap-x snap-mandatory lg:snap-none pb-8" style="scrollbar-width: none;">
      {certifications.map((cert) => (
        <div class="cert-card glass-card group flex flex-col justify-between w-[300px] h-[400px] sm:w-[350px] sm:h-[450px] rounded-[2rem] overflow-hidden flex-shrink-0 cursor-pointer hover:shadow-2xl hover:shadow-primary/20 transition-all duration-500 hover:-translate-y-2 snap-center">
          
          <div class="p-8 flex-1 flex flex-col">
            <!-- Icono y Fecha -->
            <div class="flex justify-between items-start mb-8">
              <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-3xl text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500 overflow-hidden">
                {cert.image ? (
                  <img src={cert.image} alt={cert.issuer} class="w-full h-full object-cover" />
                ) : (
                  <iconify-icon icon={cert.icon}></iconify-icon>
                )}
              </div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/5 border border-white/5 text-text-light text-[10px] uppercase tracking-wider font-black rounded-lg">
                {cert.date}
              </span>
            </div>

            <!-- Título y Emisor -->
            <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-primary transition-colors duration-300 mb-2 leading-snug">
              {cert.title}
            </h3>
            <span class="text-primary/90 font-bold block text-xs tracking-wider uppercase mb-auto">
              {cert.issuer}
            </span>

            <!-- Habilidades clave -->
            <div class="flex flex-wrap gap-2 mt-6">
              {cert.skills.slice(0, 3).map(skill => (
                <span class="px-3 py-1.5 bg-white/5 border border-white/5 text-text text-[10px] uppercase tracking-tight font-bold rounded-md group-hover:border-primary/20 transition-colors duration-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Pie de Tarjeta: Enlace -->
          {cert.url && (
            <div class="px-8 py-6 border-t border-white/5 bg-black/20 group-hover:bg-primary/5 transition-colors duration-300">
              <a 
                href={cert.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex items-center justify-between font-bold text-xs text-primary tracking-widest uppercase w-full"
                data-i18n="cert_view_link"
              >
                Ver Credencial 
                <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors duration-300">
                  <iconify-icon icon="line-md:arrow-right" class="text-sm"></iconify-icon>
                </div>
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  function initCertifications() {
    gsap.registerPlugin(ScrollTrigger);

    // Animación del header
    gsap.to("#certifications-header .section-title, #certifications-header .section-subtitle", {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.2,
      scrollTrigger: {
        trigger: "#certifications-header",
        start: "top 80%"
      }
    });

    // Horizontal Scroll (Pin & Slide)
    const track = document.getElementById('cert-track');
    const container = document.getElementById('cert-pin-container');
    
    if (track && container) {
      let mm = gsap.matchMedia();

      // Only apply horizontal scroll on Desktop (>= 1024px)
      mm.add("(min-width: 1024px)", () => {
        const getScrollAmount = () => -(track.scrollWidth - window.innerWidth);
        
        gsap.to(track, {
          x: getScrollAmount,
          ease: "none",
          scrollTrigger: {
            trigger: container,
            start: "center center",
            end: () => `+=${track.scrollWidth}`, // La distancia de scroll es el ancho de la pista
            pin: true,
            scrub: 1, // Suaviza el scroll
            invalidateOnRefresh: true,
          }
        });
      });
    }
  }

  // Initialize
  initCertifications();

  // Reiniciar en transiciones de página
  document.addEventListener('astro:page-load', () => {
    ScrollTrigger.getAll().forEach(t => {
      if (document.querySelector("#certifications")?.contains(t.trigger as Node)) {
        t.kill();
      }
    });
    initCertifications();
  });
</script>
