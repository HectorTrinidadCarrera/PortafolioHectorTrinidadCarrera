---
import data from "../data/portfolio.json";
import ProjectCard from "./ProjectCard.astro";
import ProjectModal from "./ProjectModal.astro";
const { projects } = data;
---

<section class="section overflow-hidden" id="projects">
  <div class="container mx-auto">
    <div class="text-center mb-16" id="projects-header">
      <h2 class="section-title mb-2 opacity-0" data-i18n="projects_title">
        Mis Proyectos
      </h2>
      <span class="section-subtitle opacity-0" data-i18n="projects_subtitle"
        >"Transformando ideas en soluciones digitales elegantes"</span
      >
    </div>

    <div id="projects-pin-container" class="relative w-full pt-10 pb-10">
      <div id="projects-track" class="grid grid-cols-1 md:flex md:flex-nowrap gap-8 md:w-max px-4 md:px-0">
        {
          projects.map((project, index) => (
            <div
              class="project-trigger cursor-pointer h-full w-full md:w-[450px] lg:w-[500px] flex-shrink-0"
              data-project={JSON.stringify(project)}
              data-cursor-text="VER"
              data-cursor-stick
            >
              <ProjectCard {...project} index={index} />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <ProjectModal />
</section>

<script>
  import { animate, stagger } from "motion";
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  const initProjects = () => {
    gsap.registerPlugin(ScrollTrigger);

    const triggers = document.querySelectorAll(".project-trigger");
    triggers.forEach((trigger) => {
      const card = trigger.querySelector(".project-card");
      if (!card) return;
      
      const projectData = JSON.parse(trigger.getAttribute("data-project") || "{}");
      const cardLinks = trigger.querySelectorAll("a");

      // Prevent card links from opening the modal
      cardLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.stopPropagation();
        });
      });

      trigger.addEventListener("click", () => {
        if ((window as any).openProjectModal) {
          (window as any).openProjectModal(card, projectData);
        }
      });

      // Hover effect
      trigger.addEventListener("mouseenter", () => {
        animate(card,
          { y: -8, scale: 1.01, boxShadow: "0 20px 40px -10px rgba(0, 0, 0, 0.3)" },
          { duration: 0.2 }
        );
      });

      trigger.addEventListener("mouseleave", () => {
        animate(card,
          { y: 0, scale: 1, boxShadow: "0 1px 2px 0 rgba(0, 0, 0, 0.05)" },
          { duration: 0.2 }
        );
      });
    });

    // --- GSAP Horizontal Scroll for Desktop ---
    let mm = gsap.matchMedia();

    mm.add("(min-width: 768px)", () => {
      const track = document.getElementById("projects-track");
      if (!track) return;
      
      // Calculate how far to scroll the track
      // scrollWidth is total width, clientWidth is visible window width within the container
      const getScrollAmount = () => -(track.scrollWidth - window.innerWidth + 100); 

      // Fade in header before pinning
      gsap.to("#projects-header h2", { opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: "#projects-header", start: "top 80%" } });
      gsap.to("#projects-header p", { opacity: 1, y: 0, duration: 0.6, delay: 0.1, scrollTrigger: { trigger: "#projects-header", start: "top 80%" } });

      // Animate cards fading in
      gsap.to(".project-card", {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.5,
        stagger: 0.1,
        scrollTrigger: {
          trigger: "#projects-pin-container",
          start: "top 70%"
        }
      });

      // Horizontal Pinning with a pause at the end
      let tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#projects-pin-container",
          start: "center center",
          end: () => `+=${track.scrollWidth * 2.5}`, // Increased scroll distance to slow down the exit speed
          pin: true,
          scrub: 1.5,
          invalidateOnRefresh: true,
        }
      });

      tl.to(track, {
        x: getScrollAmount,
        ease: "none",
        duration: 1
      });
      
      // Pause at the end
      tl.to({}, { duration: 0.3 });
    });

    // Mobile fallback (Vertical Grid)
    mm.add("(max-width: 767px)", () => {
      // Just fade in
      gsap.to("#projects-header h2", { opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: "#projects-header", start: "top 80%" } });
      gsap.to("#projects-header p", { opacity: 1, y: 0, duration: 0.6, delay: 0.1, scrollTrigger: { trigger: "#projects-header", start: "top 80%" } });
      
      gsap.to(".project-card", {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.5,
        stagger: 0.1,
        scrollTrigger: {
          trigger: "#projects-pin-container",
          start: "top 80%"
        }
      });
    });
  };

  // Run on initial load
  initProjects();

  // Re-run on navigation
  document.addEventListener("astro:page-load", () => {
    // Re-initialize GSAP on page change to avoid duplicated triggers
    ScrollTrigger.getAll().forEach(t => t.kill());
    initProjects();
  });
</script>
