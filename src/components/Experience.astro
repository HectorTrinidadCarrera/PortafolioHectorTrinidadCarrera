---
import data from '../data/portfolio.json';
const { experience, education } = data.about;

const trajectory = [
  ...experience.map(item => ({ ...item, type: 'experience', badge: 'Experiencia' })),
  ...education.map(item => ({ ...item, type: 'education', badge: 'Educación' }))
];
---

<section class="section relative overflow-hidden" id="qualification">
  <!-- Background Decoration -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none opacity-20 dark:opacity-10">
    <div class="absolute top-1/4 -left-20 w-64 h-64 bg-primary blur-[120px] rounded-full animate-pulse"></div>
    <div class="absolute bottom-1/4 -right-20 w-64 h-64 bg-secondary blur-[120px] rounded-full animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="container relative z-10">
    <div class="text-center mb-16">
      <h2 class="section-title mb-2" data-aos="fade-up" data-i18n="experience_title">Trayectoria</h2>
      <span class="section-subtitle" data-aos="fade-up" data-aos-delay="100" data-i18n="experience_subtitle">Mi camino profesional y académico</span>
    </div>

    <!-- Content Area -->
    <div class="max-w-4xl mx-auto px-4 md:px-0">
      <div class="relative min-h-[300px]" id="trajectory-content">
        <div class="space-y-10 relative">
          <!-- Background Line -->
          <div class="absolute inset-0 left-[0.625rem] md:left-1/2 -translate-x-px h-full w-0.5 bg-white/5 rounded-full"></div>
          <!-- Progress Line (Animated by GSAP) -->
          <div id="trajectory-line-progress" class="absolute top-0 left-[0.625rem] md:left-1/2 -translate-x-px h-0 w-0.5 bg-gradient-to-b from-primary via-primary to-primary/50 shadow-[0_0_15px_rgba(163,117,255,0.5)] rounded-full z-0"></div>
          
          {trajectory.map((item, index) => (
            <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between md:odd:flex-row-reverse group" data-aos="fade-up" data-aos-delay={index * 100}>
              <!-- Dot -->
              <div class="traj-dot absolute left-[0.625rem] md:left-1/2 -translate-x-1/2 top-2 md:top-auto w-4 h-4 bg-[var(--color-body)] rounded-full z-10 border-2 border-primary/30 transition-all duration-300 group-hover:scale-150 group-hover:shadow-[0_0_20px_rgba(163,117,255,0.6)] group-hover:border-primary/20"></div>
              
              <div class={`w-full md:w-[calc(50%-2.5rem)] pl-10 md:pl-0 ${index % 2 === 0 ? 'md:text-right' : 'md:text-left'}`}>
                <div class="glass-card p-6 group-hover:-translate-y-1" data-tilt>
                  <div class={`flex items-center gap-4 mb-4 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
                    <div class="w-12 h-12 rounded-2xl bg-primary/10 flex-shrink-0 flex items-center justify-center text-2xl text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500 overflow-hidden">
                      {item.image ? (
                        <img src={item.image} alt={item.company || item.institution} class="w-full h-full object-cover" />
                      ) : item.svg ? (
                        <div class="w-8 h-8 flex items-center justify-center" set:html={item.svg} />
                      ) : (
                        <iconify-icon icon={item.icon || (item.type === 'education' ? 'line-md:academic-cap-twotone' : 'line-md:briefcase-twotone')}></iconify-icon>
                      )}
                    </div>
                    <div>
                      <h3 class="text-xl font-bold text-title group-hover:text-primary transition-colors">{item.role || item.degree}</h3>
                      <span class="text-primary/90 font-semibold block text-sm tracking-wide uppercase">{item.company || item.institution}</span>
                    </div>
                  </div>
                  
                  <div class={`flex flex-wrap gap-2 mb-4 ${index % 2 === 0 ? 'md:justify-end' : 'md:justify-start'}`}>
                    <span class="inline-flex items-center gap-1.5 text-text-light text-xs font-bold bg-white/5 border border-white/10 px-3 py-1.5 rounded-full">
                      <iconify-icon icon={item.type === 'education' ? 'line-md:academic-cap-twotone' : 'line-md:briefcase-twotone'} class="text-primary"></iconify-icon> {item.badge}
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-text-light text-xs font-bold bg-primary/10 border border-primary/10 px-3 py-1.5 rounded-full">
                      <iconify-icon icon="line-md:calendar" class="text-primary"></iconify-icon> {item.years}
                    </span>
                  </div>

                  <p class="text-text text-[13px] md:text-sm leading-relaxed opacity-70 group-hover:opacity-100 transition-opacity">
                    {item.description}
                  </p>
                </div>
              </div>

              <!-- Spacer for MD to keep timeline centered -->
              <div class="hidden md:block w-[calc(50%-2.5rem)]"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  function initTrajectory() {
    gsap.registerPlugin(ScrollTrigger);

    const content = document.getElementById('trajectory-content');
    const line = document.getElementById('trajectory-line-progress');
    const dots = document.querySelectorAll('.traj-dot');

    if (line && content) {
      gsap.to(line, {
        height: '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: content,
          start: 'top center',
          end: 'bottom center',
          scrub: true
        }
      });
    }

    dots.forEach(dot => {
      gsap.to(dot, {
        backgroundColor: '#a375ff',
        borderColor: 'transparent',
        boxShadow: '0 0 15px rgba(163, 117, 255, 0.8)',
        scale: 1.2,
        scrollTrigger: {
          trigger: dot,
          start: 'top center',
          toggleActions: 'play none none reverse'
        }
      });
    });
  }

  // Initialize on load
  initTrajectory();

  // Re-initialize on Astro page load (for view transitions)
  document.addEventListener('astro:page-load', initTrajectory);
</script>
