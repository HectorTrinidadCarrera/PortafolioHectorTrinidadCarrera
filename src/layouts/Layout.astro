---
import '../styles/global.css';
import 'mouse-follower/dist/mouse-follower.min.css';
import PageLoader from '../components/PageLoader.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.0.3/src/regular/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.0.3/src/bold/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.0.3/src/fill/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <script is:inline src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    <title>{title}</title>

    <script is:inline>
      const storedTheme = localStorage.getItem('portfolio-theme');
      const isDark = storedTheme
        ? storedTheme === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', isDark);
    </script>
  </head>
  <body>
    <PageLoader />
    <canvas id="particle-canvas"></canvas>
    <slot />

    <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
      import { initGlobalEffects } from '../lib/effects';
      import { initLanguage } from '../lib/i18n';
      import { initMouseFollower } from '../lib/mouse-follower';

      function initLayoutBehavior() {
        (window as Window & { AOS?: { init: (options: Record<string, unknown>) => void } }).AOS?.init({
          duration: 1000,
          offset: 100,
          once: true,
        });
        initGlobalEffects();
        initLanguage();
        initMouseFollower();
      }

      initLayoutBehavior();
      document.addEventListener('astro:page-load', initLayoutBehavior);
    </script>
  </body>
</html>
